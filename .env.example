# EventPilot AI Configuration
APP_NAME="EventPilot AI"
APP_VERSION="1.1.0"

# AI Inference Settings
# Supported AI_PROVIDER values:
#   1. "ollama" - local Gemma model via Ollama (e.g. gemma2:2b or gemma:2b)
#   2. "openai_compatible" - hosted Gemma endpoint (e.g. Groq free tier with gemma2-9b-it)
#   3. "demo" - deterministic offline planner for instant UI testing without model calls
AI_PROVIDER=ollama
GEMMA_MODEL=gemma2:2b
INFERENCE_BASE_URL=http://localhost:11434
INFERENCE_API_KEY=""
INFERENCE_TIMEOUT_SECONDS=60

# Sentry Agent Tracing & Observability
# Paste your real Sentry DSN here (e.g. https://public@sentry.io/1234567)
SENTRY_DSN=""
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Database
DATABASE_PATH=eventpilot.db

# Server / Render
PORT=8000
HOST=0.0.0.0
